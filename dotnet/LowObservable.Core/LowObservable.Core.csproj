<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the engine-free core from ../../core/Runtime, the same sources Unity compiles through the
    com.brennandrake.lowobservable.core package. Keep the language version at Unity's (C# 9) so code
    that compiles here also compiles in the editor.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>LowObservable.Core</RootNamespace>
    <AssemblyName>LowObservable.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../core/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
